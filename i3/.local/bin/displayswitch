#!/bin/sh

options='Extended\nClone\nMain/Laptop only'

for layout in ${HOME}/.screenlayout/*; do
    name="layout/$(basename $layout .sh)"
    options="${options}\n${name}"
done

options="${options}\nOpen Arandr"

choice=$(echo "$options" | rofi -dmenu -theme sidebar -p 'Select configuration' -i)

[ -z "$choice" ] && exit 0

case $choice in
    "Extended")
        monitors extended right
        ;;
    "Clone")
        monitors clone
        ;;
    "Main/Laptop only")
        monitors main_only
        ;;
    "Open Arandr")
        arandr
        ;;
    layout/*)
        script="${HOME}/.screenlayout/$(echo $choice | sed 's|layout/||g').sh"
        $script
        ;;
esac

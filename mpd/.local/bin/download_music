#!/bin/sh

# abstract: downloads song(s) to the current monthly playlist and synchronizes mpd

if [ $# -lt 1 ]; then
    echo "usage: $0 <url_1> [url_2] [url_3] [...]"
    exit 2
fi

cd "$(monthly_playlist)"
echo "Downloading music to ${PWD}"
downloadedFile=$(yt-dlp -f bestaudio --restrict-filenames --add-metadata --no-playlist --get-filename --no-simulate --no-warnings $@)
echo "Finished downloading. Pausing before adding to mpd..."
sleep 10 # attempt to make mpc add reliable...
mpc --verbose add "$(basename ${PWD})/$downloadedFile"

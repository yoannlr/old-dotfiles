#!/bin/bash
# abstract: backs up files/folders as defined in ~/.config/backups

conf="${XDG_CONFIG_HOME:-$HOME/.config}/backups"

while read line; do
    if echo "$line" | grep -qE '^#'; then
        continue
    fi

	src=$(echo "$line" | awk '{print $1}')
	dst=$(echo "$line" | awk '{print $2}')
	args=$(echo "$line" | awk '{print $3}')

	[ ! -d "$dst" ] && { echo "destination '$dst' does not exist, skipping"; continue; }
	[ ! -d "$src" ] && { echo "source '$src' does not exist, skipping"; continue; }

	rsync -avS --delete "$src" "$dst" $args
done < "$conf"

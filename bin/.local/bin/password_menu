#!/bin/sh

# abstract: password menu with support for rbw and pass (passmenu with otp support)

menu="dmenu -fn Monospace:10 -p Passwords -i -l 10"
if [ ! -z "$TERM" ]; then
    menu="fzy -l 10"
fi

prefix() {
    pref="$1"
    cat - | while read line; do
        echo "${1}${line}"
    done
}

# merge pass and rbw into a single list for the menu
entry=$({ \
    command -v pass > /dev/null && pass list | sed '1d' | colrm 1 4 | prefix "[pass] " ; \
    command -v rbw > /dev/null && rbw list | prefix "[rbw] " ; \
} | $menu)

[ -z "$entry" ] && exit 0

if echo "$entry" | grep -qE '^\[pass\]'; then
    entry="$(echo $entry | sed -Ee 's/^\[pass\] //g;s/\.gpg$//g')"
    if [ $(echo "$entry" | grep -E '^otp:') ]
    then
        if [ -z "$TERM" ]; then
            pass otp --clip "$entry"
        else
            pass otp "$entry"
        fi
    else
        if [ -z "$TERM" ]; then
            pass --clip "$entry"
        else
            pass "$entry"
        fi
    fi
elif echo "$entry" | grep -qE '^\[rbw\]'; then
    entry="$(echo $entry | sed -Ee 's/^\[rbw\] //g')"
    if [ -z "$TERM" ]; then
        rbw get "$entry" | tr -d '\n' | xclip -selection clipboard -i
    else
        rbw get "$entry"
    fi
fi

#!/bin/sh

BACKGROUNDS="${HOME}/.local/share/backgrounds" # gnome copies its backgrounds here
[ ! -d "$BACKGROUNDS" ] && exit 0

chosen="$(ls "$BACKGROUNDS" | sort -R | head -n 1)"
echo "$chosen"
gsettings set org.gnome.desktop.background picture-uri "${BACKGROUNDS}/${chosen}"
gsettings set org.gnome.desktop.background picture-uri-dark "${BACKGROUNDS}/${chosen}"
